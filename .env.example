# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Telegram API credentials (https://my.telegram.org/apps)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Bot token from @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram user ID of the bot owner
OWNER_ID=1234567890

# Git repository used for self-updating (optional, leave empty to disable)
GITHUB_REPO_URL=https://github.com/m2k7m/XAVATAR-telegramBot
# Personal access token used to clone the private repo (optional)
GITHUB_TOKEN=
